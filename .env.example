# BazarDor Public API URL
NEXT_PUBLIC_API_URL=https://openapi.programming-hero.com/api/bazardor

# BetterAuth Base URL & Signing Secret (>= 32 random chars in production)
BETTER_AUTH_SECRET=replace-with-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# MongoDB Connection String (required in production runtime)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bazar-dor

# Social OAuth Providers (configure redirect URIs: <ORIGIN>/api/auth/callback/google and /facebook)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
